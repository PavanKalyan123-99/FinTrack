# FinTrack Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Leave empty or set to mongodb://localhost:27017/fintrack
# If MongoDB is not running locally, FinTrack automatically initializes an embedded in-memory MongoDB instance for development!
MONGODB_URI=

# JWT Authentication Secret
JWT_SECRET=fintrack_super_secure_jwt_secret_production_2026_xyz
JWT_EXPIRE=30d

# Google Gemini API Key for FinTrack AI Assistant (Optional)
# If left empty, FinTrack uses its built-in algorithmic financial diagnostic engine seamlessly.
GEMINI_API_KEY=
